<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/USS/MainMenu.uss?fileID=7433441132597879392&amp;guid=7132c8e3e9a99e44ca321eb5611b5cfa&amp;type=3#MainMenu"/>
    <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <ui:VisualElement name="MainMenuContainer" class="container" style="flex-grow: 1; width: 429px; top: auto; position: absolute; height: 594px; left: auto; bottom: auto; justify-content: flex-end; align-items: center; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
            <ui:VisualElement name="Logo" style="flex-grow: 1; width: 343px; position: relative; height: 153px; top: auto; left: auto; background-color: rgb(221, 221, 221); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px;"/>
            <ui:Button text="Play" name="PlayButton" class="button" style="height: 77px; width: 363px;"/>
            <ui:Button text="Settings" name="SettingsButton" class="button" style="height: 77px; width: 363px;"/>
            <ui:Button text="Credits" name="CreditsButton" class="button" style="height: 77px; width: 363px;"/>
            <ui:Button text="Quit" name="QuitButton" parse-escape-sequences="true" class="button" style="height: 77px; width: 363px; bottom: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContainer" class="container settings-hidden" style="top: 89px; left: auto; transition-property: opacity, translate, scale; transition-duration: 0.25s, 0.5s, 0.25s; transition-timing-function: ease, ease-out, ease; align-items: stretch; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; width: 769px;">
            <ui:Label text="Settings" name="SettingsTitle" class="label" style="height: 75px; width: 682px; -unity-text-align: middle-center; white-space: pre-wrap; font-size: 70px;"/>
            <ui:Slider label="Volume" value="100" high-value="0" name="VolumeSlider" show-input-field="false" low-value="-80" class="slider" style="height: 44px; width: 659px; flex-direction: row; align-self: auto; justify-content: center; align-items: flex-start;"/>
            <ui:DropdownField label="Resolution" name="ResolutionDropdown" style="font-size: 30px; width: 464px;"/>
            <ui:EnumField label="Quality" value="Left" type="UnityEngine.UIElements.UIR.RenderTree+AllowedClasses, UnityEngine.UIElementsModule" include-obsolete-values="true" name="QualityDropdown" style="width: 460px; font-size: 30px;"/>
            <ui:Toggle label="Fullscreen" value="false" name="FullscreenToggle" style="font-size: 30px; width: 217px;"/>
            <ui:Button text="Close" name="CloseSettingsButton" class="button" style="width: 194px; white-space: normal; height: 54px; font-size: 30px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsContainer" class="credits-container hidden" style="height: 100%; overflow: hidden; top: auto; width: 100%; left: auto; align-items: flex-start; justify-content: flex-end; background-color: rgba(106, 106, 106, 0.89);">
